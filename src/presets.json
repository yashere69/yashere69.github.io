      "argv": [
       "audit",
       "indigo-loom-fixed.csv",
       "--fail-on",
       "never"
      ]
     }
    ]
   }
  ]
 },
 "chunkbench": {
  "input": null,
  "presets": [
   {
    "label": "top-k",
    "steps": [
     {
      "tool": "chunkbench",
      "argv": [
       "run",
       "corpus",
       "--retriever",
       "bm25"
      ]
     }
    ]
   },
   {
    "label": "equal word budget",
    "steps": [
     {
      "tool": "chunkbench",
      "argv": [
       "run",
       "corpus",
       "--retriever",
       "bm25",
       "--budget",
       "200"
      ]
     }
    ]
   }
  ]
 },
 "chat2faq": {
  "input": null,
  "presets": [
   {
    "label": "mine 40 chats",
    "steps": [
     {
      "tool": "chat2faq",
      "argv": [
       "exports",
       "--business",
       "Indigo Loom"
      ]
     }
    ]
   }
